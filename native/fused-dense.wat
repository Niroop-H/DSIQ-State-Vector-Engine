(module
  (import "env" "memory" (memory 1))
  ;; Each complex128 amplitude occupies 16 bytes. stride is the distance
  ;; in bytes between partners that differ at the target bit.
  (func (export "local") (param $end i32) (param $stride i32)
    (param $ar f64) (param $ai f64) (param $br f64) (param $bi f64)
    (param $cr f64) (param $ci f64) (param $dr f64) (param $di f64)
    (local $base i32) (local $x i32) (local $y i32)
    (local $xr f64) (local $xi f64) (local $yr f64) (local $yi f64)
    (loop $blocks
      (local.set $x (local.get $base))
      (loop $pairs
        (local.set $y (i32.add (local.get $x) (local.get $stride)))
        (local.set $xr (f64.load (local.get $x)))
        (local.set $xi (f64.load offset=8 (local.get $x)))
        (local.set $yr (f64.load (local.get $y)))
        (local.set $yi (f64.load offset=8 (local.get $y)))
        (f64.store (local.get $x)
          (f64.add (f64.sub (f64.mul (local.get $ar) (local.get $xr)) (f64.mul (local.get $ai) (local.get $xi)))
                   (f64.sub (f64.mul (local.get $br) (local.get $yr)) (f64.mul (local.get $bi) (local.get $yi)))))
        (f64.store offset=8 (local.get $x)
          (f64.add (f64.add (f64.mul (local.get $ar) (local.get $xi)) (f64.mul (local.get $ai) (local.get $xr)))
                   (f64.add (f64.mul (local.get $br) (local.get $yi)) (f64.mul (local.get $bi) (local.get $yr)))))
        (f64.store (local.get $y)
          (f64.add (f64.sub (f64.mul (local.get $cr) (local.get $xr)) (f64.mul (local.get $ci) (local.get $xi)))
                   (f64.sub (f64.mul (local.get $dr) (local.get $yr)) (f64.mul (local.get $di) (local.get $yi)))))
        (f64.store offset=8 (local.get $y)
          (f64.add (f64.add (f64.mul (local.get $cr) (local.get $xi)) (f64.mul (local.get $ci) (local.get $xr)))
                   (f64.add (f64.mul (local.get $dr) (local.get $yi)) (f64.mul (local.get $di) (local.get $yr)))))
        (local.set $x (i32.add (local.get $x) (i32.const 16)))
        (br_if $pairs (i32.lt_u (local.get $x) (i32.add (local.get $base) (local.get $stride)))))
      (local.set $base (i32.add (local.get $base) (i32.shl (local.get $stride) (i32.const 1))))
      (br_if $blocks (i32.lt_u (local.get $base) (local.get $end)))))
  (func (export "cx") (param $end i32) (param $target i32) (param $control i32)
    (local $x i32) (local $y i32) (local $real i64) (local $imag i64)
    (loop $scan
      (if (i32.and (i32.eqz (i32.and (local.get $x) (local.get $target)))
                   (i32.ne (i32.and (local.get $x) (local.get $control)) (i32.const 0)))
        (then
          (local.set $y (i32.or (local.get $x) (local.get $target)))
          (local.set $real (i64.load (local.get $x)))
          (local.set $imag (i64.load offset=8 (local.get $x)))
          (i64.store (local.get $x) (i64.load (local.get $y)))
          (i64.store offset=8 (local.get $x) (i64.load offset=8 (local.get $y)))
          (i64.store (local.get $y) (local.get $real))
          (i64.store offset=8 (local.get $y) (local.get $imag))))
      (local.set $x (i32.add (local.get $x) (i32.const 16)))
      (br_if $scan (i32.lt_u (local.get $x) (local.get $end)))))
  ;; Apply an RX mixer to interleaved complex128 pairs. The two lanes
  ;; carry the real and imaginary part of one amplitude.
  (func (export "rx") (param $start i32) (param $end i32) (param $stride i32)
    (param $cos f64) (param $sin f64)
    (local $base i32) (local $i i32) (local $j i32)
    (local $x v128) (local $y v128) (local $c v128) (local $s v128)
    (local.set $base (local.get $start))
    (local.set $c (f64x2.splat (local.get $cos)))
    (local.set $s (f64x2.replace_lane 1 (f64x2.splat (local.get $sin)) (f64.neg (local.get $sin))))
    (loop $blocks
      (local.set $i (local.get $base))
      (loop $pairs
        (local.set $j (i32.add (local.get $i) (local.get $stride)))
        (local.set $x (v128.load (local.get $i)))
        (local.set $y (v128.load (local.get $j)))
        (v128.store (local.get $i) (f64x2.add (f64x2.mul (local.get $c) (local.get $x))
          (f64x2.mul (local.get $s) (i8x16.shuffle 8 9 10 11 12 13 14 15 0 1 2 3 4 5 6 7 (local.get $y) (local.get $y)))))
        (v128.store (local.get $j) (f64x2.add (f64x2.mul (local.get $c) (local.get $y))
          (f64x2.mul (local.get $s) (i8x16.shuffle 8 9 10 11 12 13 14 15 0 1 2 3 4 5 6 7 (local.get $x) (local.get $x)))))
        (local.set $i (i32.add (local.get $i) (i32.const 16)))
        (br_if $pairs (i32.lt_u (local.get $i) (i32.add (local.get $base) (local.get $stride)))))
      (local.set $base (i32.add (local.get $base) (i32.shl (local.get $stride) (i32.const 1))))
      (br_if $blocks (i32.lt_u (local.get $base) (local.get $end)))))
)
